<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\CustomerData\DefaultItem">
        <plugin name="sunmerce_remote_gallery_checkout_customer_data_item" type="Sunmerce\RemoteGallery\Plugin\Checkout\DefaultItemPlugin"/>
    </type>
    <type name="Magento\Checkout\Model\Cart\ImageProvider">
        <plugin name="sunmerce_remote_gallery_checkout_cart_image_provider" type="Sunmerce\RemoteGallery\Plugin\Checkout\CartImageProviderPlugin"/>
    </type>
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="sunmerce_remote_gallery_img_src" xsi:type="object">Sunmerce\RemoteGallery\Model\Csp\ImgSrcCollector</item>
            </argument>
        </arguments>
    </type>
</config>
