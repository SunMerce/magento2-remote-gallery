<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="sunmerce_remote_gallery" xsi:type="array">
                    <item name="class" xsi:type="string">Sunmerce\RemoteGallery\Ui\DataProvider\Product\Form\Modifier\RemoteGallery</item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Catalog\Ui\Component\Listing\Columns\Thumbnail">
        <plugin name="sunmerce_remote_gallery_admin_product_grid_thumbnail" type="Sunmerce\RemoteGallery\Plugin\Adminhtml\Product\Listing\ThumbnailPlugin"/>
    </type>
</config>
